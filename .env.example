# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# API-Football (free plan, 100 req/day) — https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Slack incoming webhook → your #world-cup channel
SLACK_WEBHOOK_URL=

# Random secret protecting the cron endpoint (openssl rand -hex 24)
CRON_SECRET=

# Admin login password
ADMIN_PASSWORD=

# Public base URL of the deployed app (e.g. https://world-cup-sweepstake.vercel.app)
NEXT_PUBLIC_APP_URL=

# Neon Postgres — added automatically by the Vercel Neon integration.
# DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
