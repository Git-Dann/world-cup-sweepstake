// World Cup 2026 Office Sweepstake — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A person in the office playing the sweepstake
model Player {
  id         String      @id @default(cuid())
  name       String
  paid       Boolean     @default(false)
  teams      Team[] // teams this player is the primary owner of
  extraTeams ExtraTeam[] // shared second teams, to level 1-team vs 2-team players
  createdAt  DateTime    @default(now())
}

// A national team in the tournament (48 of them)
model Team {
  id           String       @id @default(cuid())
  apiId        Int          @unique // API-Football team id
  name         String
  code         String? // 3-letter code, e.g. ENG
  groupName    String? // A..L
  logoUrl      String? // API-Football badge URL
  flagUrl      String? // country flag URL
  localBadge   String? // self-hosted badge path, e.g. /teams/ENG.png
  ownerId      String?
  owner        Player?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  points       Int          @default(0) // denormalised total for fast leaderboards
  reachedRound String       @default("GROUP") // furthest round reached
  eliminated   Boolean      @default(false)
  exitRound    String?
  homeFixtures Fixture[]    @relation("HomeTeam")
  awayFixtures Fixture[]    @relation("AwayTeam")
  scoreEvents  ScoreEvent[]
  extraOwners  ExtraTeam[] // players who hold this as a shared second team
  createdAt    DateTime     @default(now())
}

// A shared "second team" assignment. Players who only drew one team in the
// draw are topped up to two via a random co-owned team, so the leaderboard is
// fair whether you hold one or two teams. A team may appear here for several
// players (co-ownership); its points count towards each of their totals.
model ExtraTeam {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([playerId, teamId])
  @@index([playerId])
}

// A match
model Fixture {
  id              String   @id @default(cuid())
  apiId           Int      @unique // API-Football fixture id
  kickoff         DateTime
  status          String   @default("NS") // NS, 1H, HT, 2H, ET, P, FT, AET, PEN, PST, CANC...
  round           String   @default("Group Stage") // API-Football league.round string
  homeTeamId      String?
  homeTeam        Team?    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId      String?
  awayTeam        Team?    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeGoals       Int?
  awayGoals       Int?
  winnerTeamApiId Int? // football-data id of the winner (knockouts)
  duration        String? // REGULAR, EXTRA_TIME, PENALTY_SHOOTOUT
  penHome         Int?
  penAway         Int?
  finished        Boolean  @default(false)
  pointsProcessed Boolean  @default(false) // group W/D/L points awarded
  resultPosted    Boolean  @default(false) // result posted to Slack
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// Ledger of points awarded — powers the live leaderboard, audit, and "today's movers"
model ScoreEvent {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fixtureId String?
  kind      String // WIN, DRAW, GOAL
  points    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([teamId])
}

// Singleton config row (id = 1) — editable in the admin
model Setting {
  id              Int       @id @default(1)
  prizeText       String    @default("Bragging rights 🏆")
  potText         String?
  scoring         Json? // editable scoring config; defaults applied in code
  logoUrl         String? // optional header logo image (defaults to a trophy emoji)
  bgUrl           String? // optional page background image
  drawCompletedAt DateTime?
  leagueId        Int       @default(1) // API-Football: World Cup = 1
  season          Int       @default(2026)
  updatedAt       DateTime  @updatedAt
}
